<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests over moca-spec's examples (MOCA_SPEC_DIR, or ../moca-spec next to this repository). tests/parity holds
       the expected answers every build must give. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenMoca.Mcp\OpenMoca.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\parity\*.json" Link="parity\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
